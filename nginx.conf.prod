# HTTP
server {
    listen 80;
    server_name wisswan.tech; # Укажи свой домен вместо localhost
    proxy_set_header X-Forwarded-Proto https;
    fastcgi_param HTTPS on;

    # 1. Сначала проверяем API. Если запрос к API — обрабатываем прямо здесь (на 80 порту)
    location /api {
        # Копируем настройки из SSL блока, чтобы работало так же
        root /var/www/public;
        try_files $uri /index.php?$query_string;

        # Важно: Сообщаем Laravel, что "на самом деле" мы на HTTPS, 
        # чтобы ссылки в JSON ответах были правильными
        fastcgi_param HTTPS on; 
    }

    # 2. Обработка PHP для API на 80 порту
    location ~ \.php$ {
        root /var/www/public;
        fastcgi_pass backend:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS on; # Обманываем Laravel
    }

    # остальное редирект с http -> https
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS
server {
    listen 443 ssl;
    server_name wisswan.tech;

    root /var/www/public;
    index index.php;

    # Пути к сертификатам (те, что мы пробросили через volumes в docker-compose)
    ssl_certificate /etc/letsencrypt/live/wisswan.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wisswan.tech/privkey.pem;

    # Оптимизация SSL (стандартные хорошие настройки)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Запросы к API (Laravel)
    location /api {
        try_files $uri /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass wisswan-backend:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }

    # Всё остальное — на Next.js (Frontend)
    location / {
        proxy_pass http://wisswan-frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        
        # Передаем реальный IP пользователя
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}